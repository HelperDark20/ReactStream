# Copia este archivo como .env y completa los valores reales
# NUNCA subas el .env real a Git

PORT=3000

# Secreto para firmar tokens JWT del panel de admin
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-al-menos-32-chars

# Sal para hashear contraseñas de admin
PASSWORD_SALT=cambia-esto-tambien

# Ruta de la base de datos (Railway usa /data persistente)
DB_PATH=/data/licenses.db

# Orígenes permitidos para CORS (separados por coma, o * para todos)
ALLOWED_ORIGINS=*
