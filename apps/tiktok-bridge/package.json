{
  "name": "@reactstream/tiktok-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge Node.js — único componente que conoce TikTok. Sin lógica de negocio (Sección 24).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node esbuild.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tiktok-live-connector": "^1.2.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
